# 复制本文件为 .env 后修改（或者直接把变量写进 docker-compose / systemd）
# 本项目的 server.js 直接读取系统环境变量，不会自动加载 .env 文件，
# 如需 .env 支持，用 `node --env-file=.env server.js` 启动（Node 20.6+）。

# 监听端口
PORT=8787

# 监听地址，0.0.0.0 表示所有网卡
HOST=0.0.0.0

# 上游接口（一般不用改）
UPSTREAM=https://api.4399pc.cc/claim_by_key

# API 1 - baishanjun
API_KEY_1=aku_6648b8a4a0204d6168e180086b206ac47d96a29e

# API 2 - chenxx
API_KEY_2=aku_b625effc303427b2e8ae1dd817756ad38717f639

# 访问口令：留空 = 任何人打开网页都能用（消耗你的额度）
# 公网部署强烈建议设置一串随机字符，前端会要求输入口令
ACCESS_TOKEN=

# 限速：每个 IP 在 60 秒内最多请求 10 次
LIMIT_WINDOW_MS=60000
LIMIT_MAX=10

# 请求上游超时（毫秒）
UPSTREAM_TIMEOUT_MS=25000

# 允许的跨域来源。同域部署保持 * 即可
CORS_ORIGIN=*
